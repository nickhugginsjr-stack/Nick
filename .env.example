DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sos_dev?schema=public"

# Twilio (required for real outbound calling — see README for setup)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
REP_PHONE_NUMBER=

# Public base URL Twilio can reach for webhooks (e.g. an ngrok tunnel in dev)
PUBLIC_BASE_URL=http://localhost:3000

# Minimum dials/day goal shown on the Daily Goal bar (default 100)
DAILY_DIAL_GOAL=100
